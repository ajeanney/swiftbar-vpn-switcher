# Full tunnel: all traffic and DNS go through the VPN.
# Point `config` at the real profile you got from your VPN admin. Keep that file OUTSIDE
# this repo: it usually contains your certificate and private key.
config /path/to/your-real-profile.ovpn
redirect-gateway def1
# Drop IPv6 DNS servers the server pushes (adjust or remove for your server).
pull-filter ignore "dhcp-option DNS 2606"
pull-filter ignore "dhcp-option DNS 2001"
dns-updown force
